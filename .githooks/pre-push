#!/bin/sh
#
# Corre los gates del repo antes de pushear.
#
# Existe porque llegaron a `main` cuatro veces cosas que estos comandos habrían
# frenado en un segundo: tres `title=` nativos (que `check:ui` prohíbe) y un test
# roto. Arreglarlo después es más caro que esperar diez segundos acá.
#
# Se activa solo: `npm install` deja `core.hooksPath` apuntando a `.githooks/`.
# Para saltarlo en un caso puntual: `git push --no-verify`.

set -e

# Empujar solo tags no cambia código: es el paso final de un release cuyo commit
# ya pasó por acá. Volver a correr todo ahí solo alarga el release.
solo_tags=1
while read -r local_ref _local_sha _remote_ref _remote_sha; do
  [ -z "$local_ref" ] && continue
  case "$local_ref" in
    refs/tags/*) ;;
    *) solo_tags=0 ;;
  esac
done

if [ "$solo_tags" = "1" ]; then
  exit 0
fi

# Git exporta GIT_DIR (y compañía) a los hooks. Los tests que crean repos de
# usar y tirar corren `git` con `cwd` en un tmpdir, pero GIT_DIR gana sobre el
# cwd: heredado, sus `init`/`add`/`commit` caen en ESTE repo. Deja commits
# «initial commit» en la rama que estás pusheando y el índice con dos archivos.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

echo "pre-push: contrato de UI…"
npm run --silent check:ui

echo "pre-push: tests…"
npm test --silent

echo "pre-push: ok"
