<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 compila JIT en runtime; sin esto el renderer crasea al arrancar. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- node-pty y demás módulos nativos vienen en asarUnpack, fuera del bundle
       firmado como código propio: hardened runtime los rechazaría. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Los paneles de agente lanzan `claude`/`cursor-agent`/`copilot` como
       procesos hijo con PATH y env del login shell. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.inherit</key>
  <true/>

  <!-- Push-to-talk / Web Speech API en el composer (Hardened Runtime). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
